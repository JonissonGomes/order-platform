# Backend API URL
# Desenvolvimento: Deixe vazio ou nao configure (o proxy do Vite redireciona /api para http://localhost:8080)
# Ou configure: VITE_API_URL=http://localhost:8080 para fazer requisicoes diretas
# Producao: OBRIGATORIO - Configure a URL completa do backend, ex: https://api.meusite.com
VITE_API_URL=http://localhost:8080

# Frontend Environment Variables
# As variaveis abaixo sao opcionais

# Gemini API (Opcional - Para recursos de IA no servidor Node.js)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# Configure apenas se for usar recursos de IA no servidor Node.js
BUILT_IN_FORGE_API_KEY=your-gemini-api-key
# Ou use GEMINI_API_KEY como alternativa
GEMINI_API_KEY=your-gemini-api-key

# Google Maps API (Opcional - Frontend para Mapas)
# Configure apenas se for usar mapas no frontend
VITE_FRONTEND_FORGE_API_URL=https://maps.googleapis.com/maps/api
VITE_FRONTEND_FORGE_API_KEY=your-google-maps-api-key

# Porta do Servidor (opcional, padrao: 3000)
PORT=3000

# Ambiente
NODE_ENV=development
