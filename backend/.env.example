# Server
PORT=8080
NODE_ENV=development

# MongoDB Atlas
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=order_platform

# JWT (obrigatório)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS (obrigatório em prod — URL da Vercel)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Bootstrap do primeiro acesso (opcional)
# Cria o usuário só se o e-mail AINDA NÃO existir. A senha no env NÃO atualiza
# contas já criadas. Após o 1º login, remova *_PASSWORD do Render/painel.
# ---------------------------------------------------------------------------

# Super admin (recomendado em produção)
SUPER_ADMIN_EMAIL=admin@ztscell.com.br
SUPER_ADMIN_PASSWORD=troque-esta-senha
SUPER_ADMIN_NAME=Super Admin ZTS

# Admin comum (alternativa / adicional)
# ADMIN_EMAIL=gerente@ztscell.com.br
# ADMIN_PASSWORD=troque-esta-senha
# ADMIN_NAME=Administrador
