# Frontend Environment Variables
# NÃ£o hÃ¡ variÃ¡veis obrigatÃ³rias para o frontend
# As variÃ¡veis abaixo sÃ£o opcionais

# Gemini API (Opcional - Para recursos de IA no servidor Node.js)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# Configure apenas se for usar recursos de IA no servidor Node.js
BUILT_IN_FORGE_API_KEY=your-gemini-api-key
# Ou use GEMINI_API_KEY como alternativa
GEMINI_API_KEY=your-gemini-api-key

# Google Maps API (Opcional - Frontend para Mapas)
# Configure apenas se for usar mapas no frontend
VITE_FRONTEND_FORGE_API_URL=https://maps.googleapis.com/maps/api
VITE_FRONTEND_FORGE_API_KEY=your-google-maps-api-key
